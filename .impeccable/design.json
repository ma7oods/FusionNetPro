  "narrative": {
    "northStar": "Measured Wayfinding",
    "overview": "The visual world is a quiet native Windows workspace: charcoal ground, slate work surfaces, blue actions and explicit semantic status. The selected Sleek reference contributes consistent spacing and restrained interaction; the implementation adapts it to WPF and Arabic text rather than importing web fonts or a web framework.\n\nNamed data, source labels and current state carry the hierarchy. This code-led replacement is documented as implemented, not as final user visual approval. The FusionNetPro name and existing logo remain. Low ambient light during play is a design assumption.",
    "keyCharacteristics": [
      "Charcoal and slate tonal layers with blue action emphasis.",
      "Native Segoe text and explicit LTR technical values inside an RTL-capable shell.",
      "Wrapping groups, vertical scrolling and progressive detail.",
      "Words accompany status; missing measurements remain unavailable."
    ],
    "rules": [
      {
        "name": "Resource Ownership",
        "body": "Read colors and control styles through DynamicResource and the existing named styles. ThemeService owns accent replacement; a new screen must not hard-code a competing accent.",
        "section": "colors"
      },
      {
        "name": "Evidence Beside Data",
        "body": "Keep units, source and availability with a measurement. Interface throughput and connection counts must not be presented as measured per-process transfer or game-server latency.",
        "section": "typography"
      },
      {
        "name": "Quiet Surface",
        "body": "Use tonal surfaces and thin dividers for ordinary workspace structure. A card groups a real work unit; do not add a card around every label or metric.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the named WPF brushes and styles, preserving DynamicResource accent updates.",
      "Do keep Arabic prose RTL and paths, addresses, timestamps and technical measurements explicitly LTR where the source does.",
      "Do wrap action groups and long evidence, retaining source and unavailable-state text.",
      "Do keep status words, consent review, stop and restore actions readable at compact sizes.",
      "Do verify native renders and actual keyboard behavior before claiming accessibility completion."
    ],
    "donts": [
      "Don't import the Sleek sample web palette, Inter fonts or browser layout rules over native resources.",
      "Don't turn unknown readings into zeroes, connection counts into transfer rates, or synthetic fixtures into product claims.",
      "Don't make the accent preset alter success, warning or danger semantics.",
      "Don't promote legacy glyph icons, eyebrow styles or unreviewed interaction states into new decorative patterns.",
      "Don't claim final user approval, full English localization or live OS integration validation from offline captures."
    ]
  }
