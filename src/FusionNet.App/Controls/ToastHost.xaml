<UserControl x:Class="FusionNet.App.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FusionNet.App.Localization"
             Background="{x:Null}"
             FlowDirection="{Binding Source={x:Static loc:Loc.Instance}, Path=FlowDirection}"
             SnapsToDevicePixels="True">

    <!--
        Transparent notification overlay. The root grid has no background, so only the toast
        cards themselves are hit-test visible: clicks anywhere else reach the page underneath.
        Alignment is bottom-end (bottom-right in LTR, mirrored to bottom-left in Arabic).
    -->
    <Grid Background="{x:Null}" Margin="18">
        <ItemsControl x:Name="ItemsList"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      MaxWidth="420"
                      Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card"
                            MaxWidth="420"
                            MinWidth="300"
                            Margin="0,0,0,10"
                            Padding="0"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Cursor="Hand"
                            SnapsToDevicePixels="True"
                            MouseLeftButtonUp="OnCardMouseUp"
                            ToolTip="{loc:T Toast.DismissHint}"
                            ToolTipService.ShowDuration="9000">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270"
                                              Opacity="0.55" Color="Black" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CardSlide" Y="14" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Card"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="CardSlide"
                                                         Storyboard.TargetProperty="Y"
                                                         From="14" To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- kind-coloured accent bar (column order mirrors in RTL) -->
                            <Border x:Name="AccentBar"
                                    Grid.Column="0"
                                    Width="3"
                                    Margin="0,12,0,12"
                                    CornerRadius="2"
                                    Background="{DynamicResource Brush.Info}" />

                            <DockPanel Grid.Column="1" Margin="13,12,12,13" LastChildFill="True">
                                <!-- kind icon chip -->
                                <Border x:Name="IconChip"
                                        DockPanel.Dock="Left"
                                        Width="34"
                                        Height="34"
                                        CornerRadius="9"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.InfoSoft}">
                                    <TextBlock x:Name="Glyph"
                                               Text="{Binding Glyph}"
                                               FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="16"
                                               Foreground="{DynamicResource Brush.Info}"
                                               FlowDirection="LeftToRight"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- dismiss affordance; the whole card is clickable -->
                                <TextBlock DockPanel.Dock="Right"
                                           Text="&#xE8BB;"
                                           Style="{StaticResource Icon.Sm}"
                                           Margin="8,2,0,0"
                                           VerticalAlignment="Top"
                                           Opacity="0.45" />

                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Text.Muted}"
                                               Text="{Binding Message}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="IconChip" Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Warning}" />
                            <Setter TargetName="IconChip" Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.WarningBorder}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="IconChip" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
