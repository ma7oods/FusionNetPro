<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ typography -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ============================================================ base surfaces (shadcn zinc, dark) -->
    <Color x:Key="Color.BgDeep">#FF0F0F12</Color>
    <Color x:Key="Color.Bg">#FF09090B</Color>
    <Color x:Key="Color.Surface">#FF111113</Color>
    <Color x:Key="Color.SurfaceAlt">#FF18181B</Color>
    <Color x:Key="Color.SurfaceHover">#FF27272A</Color>
    <Color x:Key="Color.Border">#FF27272A</Color>
    <Color x:Key="Color.BorderStrong">#FF3F3F46</Color>
    <Color x:Key="Color.Text">#FFFAFAFA</Color>
    <Color x:Key="Color.TextMuted">#FFA1A1AA</Color>
    <Color x:Key="Color.TextDim">#FF8E8E96</Color>

    <Color x:Key="Color.Accent">#FF3B82F6</Color>
    <Color x:Key="Color.Accent2">#FF60A5FA</Color>
    <Color x:Key="Color.AccentInk">#FF04121A</Color>

    <!-- accent brushes are replaced at runtime by the accent theme service -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent2" Color="{DynamicResource Color.Accent2}" />
    <SolidColorBrush x:Key="Brush.AccentInk" Color="{DynamicResource Color.AccentInk}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#263B82F6" />
    <SolidColorBrush x:Key="Brush.AccentFaint" Color="#143B82F6" />
    <SolidColorBrush x:Key="Brush.AccentBorder" Color="#663B82F6" />

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource Color.Accent}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.Accent2}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.AccentGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource Color.Accent}" Offset="0" />
        <GradientStop Color="{DynamicResource Color.Accent2}" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================ window & panel gradients -->
    <SolidColorBrush x:Key="Brush.Window" Color="{DynamicResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{DynamicResource Color.BgDeep}" />
    <SolidColorBrush x:Key="Brush.Hero" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Card" Color="{DynamicResource Color.Surface}" />

    <SolidColorBrush x:Key="Brush.Bg" Color="{DynamicResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.BgDeep" Color="{DynamicResource Color.BgDeep}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{DynamicResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{DynamicResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{DynamicResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.ControlBorder" Color="#FF71717A" />
    <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{DynamicResource Color.TextDim}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="#00000000" />

    <!-- ============================================================ status colours -->
    <SolidColorBrush x:Key="Brush.Success" Color="#FF34D399" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#2634D399" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#6634D399" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#26FBBF24" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#66FBBF24" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF87171" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#26F87171" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#66F87171" />
    <SolidColorBrush x:Key="Brush.Info" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#2660A5FA" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#6660A5FA" />
    <SolidColorBrush x:Key="Brush.Violet" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="Brush.VioletSoft" Color="#26A78BFA" />

    <LinearGradientBrush x:Key="Brush.SuccessGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF34D399" Offset="0" />
        <GradientStop Color="#FF0EA5E9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF87171" Offset="0" />
        <GradientStop Color="#FFEF4444" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SparkGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#663B82F6" Offset="0" />
        <GradientStop Color="#0009090B" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================ accent presets (for Settings) -->
    <Color x:Key="AccentPreset.Cyan">#FF3B82F6</Color>
    <Color x:Key="AccentPreset.Cyan2">#FF60A5FA</Color>
    <Color x:Key="AccentPreset.Violet">#FFA78BFA</Color>
    <Color x:Key="AccentPreset.Violet2">#FF7C3AED</Color>
    <Color x:Key="AccentPreset.Emerald">#FF34D399</Color>
    <Color x:Key="AccentPreset.Emerald2">#FF10B981</Color>
    <Color x:Key="AccentPreset.Amber">#FFFBBF24</Color>
    <Color x:Key="AccentPreset.Amber2">#FFF59E0B</Color>
    <Color x:Key="AccentPreset.Rose">#FFFB7185</Color>
    <Color x:Key="AccentPreset.Rose2">#FFE11D48</Color>
</ResourceDictionary>

