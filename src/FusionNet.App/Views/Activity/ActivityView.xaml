<shell:PageBase x:Class="FusionNet.App.Views.Activity.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:FusionNet.App.Shell"
             xmlns:loc="clr-namespace:FusionNet.App.Localization"
             xmlns:ctrl="clr-namespace:FusionNet.App.Controls"
             xmlns:conv="clr-namespace:FusionNet.App.Converters"
             Background="Transparent"
             FlowDirection="{Binding Source={x:Static loc:Loc.Instance}, Path=FlowDirection}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />

        <Style x:Key="LevelIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon.Sm}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LevelKey}" Value="success">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelKey}" Value="warning">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelKey}" Value="error">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LevelPill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.InfoBorder}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LevelKey}" Value="success">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelKey}" Value="warning">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarningBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelKey}" Value="error">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LevelPillText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LevelKey}" Value="success">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelKey}" Value="warning">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelKey}" Value="error">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionStatePill" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SessionStatusKey}" Value="active">
                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SessionStateText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SessionStatusKey}" Value="active">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================ header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:T Page.Activity}" />
                    <Border Style="{StaticResource Pill.Success}" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Success}"
                                       Text="{loc:T Log.Live}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{loc:T Page.Activity.Subtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn.Icon}" Content="{StaticResource GlyphRefresh}"
                        Command="{Binding RefreshCommand}" ToolTip="{loc:T Common.Refresh}"
                        Margin="0,0,6,0" />
                <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Log.Clear}"
                        Command="{Binding ClearCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="{loc:T Log.Export}"
                        Command="{Binding ExportCommand}" />
            </StackPanel>
        </Grid>

        <!-- ============================================================ toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding Filters}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource Btn.Chip}"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                          Command="{Binding DataContext.SelectFilterCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CountText}" Margin="6,0,0,0"
                                               Opacity="0.75" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="11" />
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Column="1" Width="260" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBox Style="{StaticResource Input.SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphSearch}"
                           HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                <TextBlock FontSize="12" Margin="38,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextDim}" IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis"
                           Text="{loc:T Log.SearchPlaceholder}"
                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding EntryCountText}"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <ctrl:ToggleSwitch IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="{loc:T Log.AutoScroll}" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Log.AutoScroll}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ============================================================ main -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- live list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Eyebrow}"
                                   Text="{Binding EntryCountText}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                   Text="{Binding FilteredCountText}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="EntryList" Style="{StaticResource List.Base}"
                                 ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Focusable="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource LevelIcon}"
                                                   Text="{Binding Glyph}" VerticalAlignment="Top"
                                                   Margin="0,2,0,0" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                                   FontFamily="{DynamicResource Font.Mono}"
                                                   Text="{Binding TimeText}" VerticalAlignment="Top"
                                                   Margin="0,2,0,0" />
                                        <Border Grid.Column="2" Style="{StaticResource LevelPill}"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="0,0,10,0" Padding="8,2">
                                            <TextBlock Style="{StaticResource LevelPillText}"
                                                       Text="{Binding Category}" MaxWidth="110"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Body}"
                                                   Text="{Binding Message}" VerticalAlignment="Top"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- empty state -->
                        <Border Style="{StaticResource Card.Flat}" Padding="20"
                                VerticalAlignment="Top"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" Margin="0,18">
                                <TextBlock Style="{StaticResource Icon.Xl}" Text="{StaticResource GlyphActivity}" />
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding EmptyTitle}"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding EmptyBody}"
                                           HorizontalAlignment="Center" Margin="0,5,0,0"
                                           TextAlignment="Center" MaxWidth="360" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- journal + detail -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Md}" Text="{StaticResource GlyphClock}"
                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Style="{StaticResource Text.SectionTitle}"
                                       Text="{loc:T Log.SessionTitle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Log.SessionBody}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                       Text="{loc:T Log.SessionId}" Width="110" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}"
                                       Text="{Binding SessionIdShort}" Foreground="{DynamicResource Brush.Accent}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                       Text="{loc:T Log.RecordedChanges}" Width="110" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}"
                                       Text="{Binding JournalEntryCount}" Foreground="{DynamicResource Brush.Text}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                       Text="{loc:T Label.Status}" Width="110" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Style="{StaticResource SessionStatePill}">
                                    <TextBlock Style="{StaticResource SessionStateText}"
                                               Text="{Binding SessionStatusLabel}" />
                                </Border>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SessionStartedText}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Log.JournalEmpty}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ShowJournalEmpty, Converter={StaticResource BoolToVis}}" />

                        <!-- pending restore -->
                        <Border Style="{StaticResource Card.Flat}" Margin="0,12,0,0"
                                BorderBrush="{DynamicResource Brush.DangerBorder}"
                                Visibility="{Binding HasPendingRestore, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphWarning}"
                                               Foreground="{DynamicResource Brush.Danger}" Margin="0,0,8,0" />
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Foreground="{DynamicResource Brush.Danger}"
                                               Text="{loc:T Log.PendingRestoreTitle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Log.PendingRestoreBody}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" />
                                <Button Style="{StaticResource Btn.Danger}" Content="{Binding RestoreButtonText}"
                                        Command="{Binding RestoreNowCommand}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.SectionTitle}"
                                       Text="{loc:T Log.DetailTitle}" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Link}"
                                    Content="{loc:T Log.Copy}" Command="{Binding CopyEntryCommand}"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Log.DetailEmpty}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVis}, ConverterParameter=null}" />

                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                           Text="{loc:T Log.Time}" Width="80" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}"
                                           Text="{Binding SelectedEntry.TimeText}" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                           Text="{loc:T Log.Level}" Width="80" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                                           Text="{Binding SelectedEntry.LevelLabel}" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                           Text="{loc:T Log.Category}" Width="80" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                                           Text="{Binding SelectedEntry.Category}" />
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}" Margin="0,10" />

                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SelectedEntry.Message}"
                                       TextWrapping="Wrap" />

                            <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"
                                          Margin="0,8,0,0"
                                          Visibility="{Binding SelectedEntry.HasDetail, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{Binding SelectedEntry.Detail}" TextWrapping="Wrap" />
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Log.NoExtraDetail}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding SelectedEntry.HasDetail, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</shell:PageBase>
