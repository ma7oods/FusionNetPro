<shell:PageBase x:Class="FusionNet.App.Views.AppShield.AppShieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FusionNet.App.Localization"
             xmlns:ctrl="clr-namespace:FusionNet.App.Controls"
             xmlns:conv="clr-namespace:FusionNet.App.Converters"
             xmlns:shell="clr-namespace:FusionNet.App.Shell"
             Background="Transparent"
             FlowDirection="{Binding Source={x:Static loc:Loc.Instance}, Path=FlowDirection}">

    <shell:PageBase.Resources>
        <BooleanToVisibilityConverter x:Key="Vis.WhenTrue" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:InverseBooleanToVisibilityConverter x:Key="Vis.WhenFalse" />
        <conv:EmptyStringToVisibilityConverter x:Key="Vis.WhenText" />
        <conv:CountToVisibilityConverter x:Key="Vis.WhenItems" />
    </shell:PageBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,26">

            <!-- ===================================================== page header -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:T Page.AppShield}" />
                    <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{loc:T Page.AppShield.Subtitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border Style="{StaticResource Pill.Success}" Margin="0,0,8,0"
                            Visibility="{Binding IsArmed, Converter={StaticResource Vis.WhenTrue}}"
                            ToolTip="{loc:T Shield.Armed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphShield}"
                                       Foreground="{DynamicResource Brush.Success}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Success}"
                                       Text="{loc:T Shield.Armed}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill.Success}" Margin="0,0,8,0"
                            Visibility="{Binding IsElevated, Converter={StaticResource Vis.WhenTrue}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphAdmin}"
                                       Foreground="{DynamicResource Brush.Success}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Success}"
                                       Text="{loc:T Elevation.Elevated}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill.Warning}" Margin="0,0,8,0"
                            Visibility="{Binding IsElevated, Converter={StaticResource Vis.WhenFalse}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphWarning}"
                                       Foreground="{DynamicResource Brush.Warning}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       Text="{loc:T Elevation.NotElevated}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding RefreshStatusCommand}"
                            ToolTip="{loc:T Shield.RefreshStatus}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphRefresh}" />
                            <TextBlock Text="{loc:T Shield.RefreshStatus}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================================================== elevation / firewall info -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Background="{DynamicResource Brush.WarningSoft}"
                    BorderBrush="{DynamicResource Brush.WarningBorder}"
                    Visibility="{Binding IsElevated, Converter={StaticResource Vis.WhenFalse}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.WarningSoft}"
                            BorderBrush="{DynamicResource Brush.WarningBorder}" BorderThickness="1">
                        <TextBlock Style="{StaticResource Icon.Md}" Text="{StaticResource GlyphAdmin}"
                                   Foreground="{DynamicResource Brush.Warning}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Shield.InfoTitle}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                   Text="{loc:T Shield.InfoBody}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                   Text="{loc:T Shield.InfoExtra}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" VerticalAlignment="Center"
                            Command="{Binding RestartElevatedCommand}"
                            ToolTip="{loc:T Elevation.RestartElevated}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphAdmin}"
                                       Foreground="{DynamicResource Brush.AccentInk}" />
                            <TextBlock Text="{loc:T Elevation.RestartElevated}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Background="{DynamicResource Brush.InfoSoft}"
                    BorderBrush="{DynamicResource Brush.InfoBorder}"
                    Visibility="{Binding IsElevated, Converter={StaticResource Vis.WhenTrue}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.InfoSoft}"
                            BorderBrush="{DynamicResource Brush.InfoBorder}" BorderThickness="1">
                        <TextBlock Style="{StaticResource Icon.Md}" Text="{StaticResource GlyphShield}"
                                   Foreground="{DynamicResource Brush.Info}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Shield.InfoTitleElevated}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                   Text="{loc:T Shield.InfoBody}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================================================== summary + filters -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Shield.SummaryCaption}" />
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Margin="0,4,0,0"
                                       Text="{Binding SummaryText}" />
                            <ProgressBar Width="260" Height="6" HorizontalAlignment="Left" Margin="0,10,0,0"
                                         Minimum="0" Maximum="{Binding TotalCount, Mode=OneWay}"
                                         Value="{Binding ActiveCount, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                       Text="{Binding LastUpdated}"
                                       Visibility="{Binding LastUpdated, Converter={StaticResource Vis.WhenText}}" />
                        </StackPanel>
                        <Grid Width="300" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource Input.SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:T Shield.SearchTip}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="36,0,11,0"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Text="{loc:T Shield.SearchPlaceholder}"
                                       Visibility="{Binding SearchText, Converter={StaticResource Vis.WhenText}, ConverterParameter=invert}"
                                       IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphSearch}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Brush.TextDim}" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Btn.Chip}" Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                  Command="{Binding SelectCommand}"
                                                  ToolTip="{loc:T Shield.CategoryTip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                                       Text="{loc:T Shield.RunningOnly}" ToolTip="{loc:T Shield.RunningOnlyTip}" />
                            <ctrl:ToggleSwitch Margin="10,0,0,0" VerticalAlignment="Center"
                                               IsChecked="{Binding RunningOnly, Mode=TwoWay}"
                                               ToolTip="{loc:T Shield.RunningOnlyTip}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================================================== grouped applications -->
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,4"
                          Visibility="{Binding HasGroups, Converter={StaticResource Vis.WhenTrue}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="8,2">
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CountText}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" CornerRadius="9"
                                                Background="{DynamicResource Brush.AccentFaint}">
                                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{Binding Glyph}"
                                                       Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                        <TextBlock Style="{StaticResource Text.CardTitle}" Margin="10,0,0,0"
                                                   Text="{Binding Title}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Apps}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card.Flat}" Margin="0,0,0,8" Padding="14">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                                                Background="{DynamicResource Brush.SurfaceHover}"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Initial}"
                                                                       Style="{StaticResource Text.Body}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.Accent}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Text.CardTitle}"
                                                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Name}" />
                                                                <TextBlock Style="{StaticResource Icon.Sm}" Margin="8,0,0,0"
                                                                           Text="{Binding RecommendedGlyph}"
                                                                           Foreground="{DynamicResource Brush.Warning}"
                                                                           ToolTip="{loc:T Shield.RecommendedTip}"
                                                                           Visibility="{Binding IsRecommended, Converter={StaticResource Vis.WhenTrue}}" />
                                                            </StackPanel>
                                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                                                       Text="{Binding Description}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                            <Border Style="{StaticResource Pill.Success}" Padding="7,2"
                                                                    Visibility="{Binding IsRunning, Converter={StaticResource Vis.WhenTrue}}">
                                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                                           Foreground="{DynamicResource Brush.Success}"
                                                                           Text="{loc:T Shield.Running}" />
                                                            </Border>
                                                            <Border Style="{StaticResource Pill.Warning}" Padding="7,2" Margin="0,4,0,0"
                                                                    Visibility="{Binding IsSuspended, Converter={StaticResource Vis.WhenTrue}}">
                                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                                           Foreground="{DynamicResource Brush.Warning}"
                                                                           Text="{loc:T Shield.Suspended}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Text.Caption}"
                                                                       Text="{loc:T Shield.Processes}" />
                                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                                                                       Text="{Binding ProcessesText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding ProcessesText}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <ToggleButton Style="{StaticResource Btn.Chip}" Content="{loc:T Shield.BlockShort}"
                                                                          IsChecked="{Binding IsBlock, Mode=OneWay}"
                                                                          Command="{Binding BlockCommand}"
                                                                          ToolTip="{loc:T Shield.BlockTip}"
                                                                          Padding="10,5" Margin="0,0,6,0" />
                                                            <ToggleButton Style="{StaticResource Btn.Chip}" Content="{loc:T Shield.SuspendShort}"
                                                                          IsChecked="{Binding IsSuspend, Mode=OneWay}"
                                                                          Command="{Binding SuspendCommand}"
                                                                          ToolTip="{loc:T Shield.SuspendTip}"
                                                                          Padding="10,5" Margin="0,0,6,0" />
                                                            <ToggleButton Style="{StaticResource Btn.Chip}" Content="{loc:T Shield.ThrottleShort}"
                                                                          IsChecked="{Binding IsThrottle, Mode=OneWay}"
                                                                          Command="{Binding ThrottleCommand}"
                                                                          ToolTip="{loc:T Shield.ThrottleTip}"
                                                                          Padding="10,5" Margin="0,0,6,0" />
                                                            <ToggleButton Style="{StaticResource Btn.Chip}" Content="{loc:T Shield.IgnoreShort}"
                                                                          IsChecked="{Binding IsIgnore, Mode=OneWay}"
                                                                          Command="{Binding IgnoreCommand}"
                                                                          ToolTip="{loc:T Shield.IgnoreTip}"
                                                                          Padding="10,5" Margin="0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- empty filter state -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding HasGroups, Converter={StaticResource Vis.WhenFalse}}">
                <StackPanel Margin="0,20,0,20">
                    <TextBlock Style="{StaticResource Icon.Xl}" Text="{StaticResource GlyphSearch}"
                               Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.CardTitle}" Margin="0,10,0,0"
                               HorizontalAlignment="Center" Text="{loc:T Shield.GroupsEmpty}" />
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,5,0,0"
                               HorizontalAlignment="Center" Text="{loc:T Shield.GroupsEmptyBody}" />
                </StackPanel>
            </Border>

            <!-- ===================================================== custom applications -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       Text="{loc:T Shield.CustomTitle}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                       Text="{loc:T Shield.CustomHelp}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                   Text="{loc:T Shield.AddWith}"
                                   ToolTip="{loc:T Shield.CustomActionTip}" />
                        <ComboBox Style="{StaticResource Input.ComboBox}" Width="170" Margin="10,0,0,0"
                                  ItemsSource="{Binding ActionOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding NewCustomAction, Mode=TwoWay}"
                                  ToolTip="{loc:T Shield.CustomActionTip}" />
                        <Button Style="{StaticResource Btn.Soft}" Margin="10,0,0,0"
                                Command="{Binding AddCustomAppCommand}"
                                ToolTip="{loc:T Shield.CustomAddTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphAdd}" />
                                <TextBlock Text="{loc:T Shield.CustomAdd}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding CustomApps}" Margin="0,14,0,0"
                                  Visibility="{Binding HasCustomApps, Converter={StaticResource Vis.WhenTrue}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card.Flat}" Margin="0,0,0,8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                                Background="{DynamicResource Brush.SurfaceHover}">
                                            <TextBlock Style="{StaticResource Icon.Sm}"
                                                       Text="{StaticResource GlyphSettings}"
                                                       Foreground="{DynamicResource Brush.Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                                       Text="{Binding ExecutablePath}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ExecutablePath}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Style="{StaticResource Input.ComboBox}"
                                                  Width="160" Margin="0,0,10,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding DataContext.ActionOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedAction, Mode=TwoWay}"
                                                  ToolTip="{loc:T Shield.CustomActionTip}" />
                                        <ctrl:ToggleSwitch Grid.Column="3" VerticalAlignment="Center"
                                                           Margin="0,0,10,0"
                                                           IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                           ToolTip="{loc:T Shield.EnabledTip}" />
                                        <Button Grid.Column="4" Style="{StaticResource Btn.Icon}"
                                                Command="{Binding RemoveCommand}"
                                                ToolTip="{loc:T Shield.CustomRemoveTip}">
                                            <TextBlock Style="{StaticResource Icon.Sm}"
                                                       Text="{StaticResource GlyphDelete}"
                                                       Foreground="{DynamicResource Brush.Danger}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,12,0,4"
                               Text="{loc:T Shield.CustomEmpty}"
                               Visibility="{Binding HasCustomApps, Converter={StaticResource Vis.WhenFalse}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</shell:PageBase>
