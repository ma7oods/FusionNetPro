<shell:PageBase x:Class="FusionNet.App.Views.Gaming.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FusionNet.App.Localization"
             xmlns:ctrl="clr-namespace:FusionNet.App.Controls"
             xmlns:conv="clr-namespace:FusionNet.App.Converters"
             xmlns:shell="clr-namespace:FusionNet.App.Shell"
             Background="Transparent"
             FlowDirection="{Binding Source={x:Static loc:Loc.Instance}, Path=FlowDirection}">

    <shell:PageBase.Resources>
        <BooleanToVisibilityConverter x:Key="Vis.WhenTrue" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:InverseBooleanToVisibilityConverter x:Key="Vis.WhenFalse" />
        <conv:EmptyStringToVisibilityConverter x:Key="Vis.WhenText" />
        <conv:CountToVisibilityConverter x:Key="Vis.WhenItems" />
    </shell:PageBase.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,26">

            <!-- ===================================================== page header -->
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:T Page.Gaming}" />
                    <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{loc:T Page.Gaming.Subtitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border Style="{StaticResource Pill.Success}" Margin="0,0,10,0"
                            Visibility="{Binding IsArmed, Converter={StaticResource Vis.WhenTrue}}"
                            ToolTip="{loc:T Game.ArmedNoticeBody}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphShield}"
                                       Foreground="{DynamicResource Brush.Success}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                                       Foreground="{DynamicResource Brush.Success}"
                                       Text="{loc:T Game.ArmedNotice}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding RefreshRunningCommand}"
                            ToolTip="{loc:T Game.RunningRefresh}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphRefresh}" />
                            <TextBlock Text="{loc:T Common.Refresh}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================================================== detection mode -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Game.ModeTitle}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                       Text="{loc:T Game.ModeHelp}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Text="{Binding ModeCurrent}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ModeCurrent}" />
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- automatic -->
                        <Border Grid.Column="0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card.Flat}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAutoMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentFaint}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Style="{StaticResource Btn.Base}" Background="Transparent"
                                    BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                                    Command="{Binding SetAutoModeCommand}"
                                    ToolTip="{loc:T Game.ModeAutoTip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <Ellipse Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1.5" />
                                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Accent}"
                                                 Visibility="{Binding IsAutoMode, Converter={StaticResource Vis.WhenTrue}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Game.ModeAuto}" />
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                                   Text="{loc:T Game.ModeAutoHelp}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>

                        <!-- pinned -->
                        <Border Grid.Column="2">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Card.Flat}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinnedMode}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentFaint}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Style="{StaticResource Btn.Base}" Background="Transparent"
                                    BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                                    Command="{Binding SetPinnedModeCommand}"
                                    ToolTip="{loc:T Game.ModePinnedTip}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                                        <Ellipse Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1.5" />
                                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Brush.Accent}"
                                                 Visibility="{Binding IsPinnedMode, Converter={StaticResource Vis.WhenTrue}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Game.ModePinned}" />
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                                   Text="{loc:T Game.ModePinnedHelp}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================================================== games catalog -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Game.GamesTitle}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                       Text="{Binding GamesSummary}" />
                        </StackPanel>
                        <Grid Width="270" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource Input.SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:T Game.SearchTip}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="36,0,11,0"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                       Text="{loc:T Game.SearchPlaceholder}"
                                       Visibility="{Binding SearchText, Converter={StaticResource Vis.WhenText}, ConverterParameter=invert}"
                                       IsHitTestVisible="False" />
                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphSearch}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource Brush.TextDim}" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource Btn.Chip}" Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=OneWay}"
                                              Command="{Binding SelectCommand}"
                                              ToolTip="{loc:T Game.CategoryTip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Games}" Margin="0,14,0,0"
                                  Visibility="{Binding HasGames, Converter={StaticResource Vis.WhenTrue}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="282" MinHeight="158" Margin="0,0,12,12" Padding="16">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card.Flat}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentFaint}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                                    Background="{DynamicResource Brush.SurfaceHover}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Initial}"
                                                           Style="{StaticResource Text.SectionTitle}"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.CardTitle}"
                                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                                           Text="{Binding CategoryLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <Border Style="{StaticResource Pill.Success}" Padding="7,2"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource Vis.WhenTrue}}">
                                                    <TextBlock Style="{StaticResource Text.Caption}"
                                                               Foreground="{DynamicResource Brush.Success}"
                                                               Text="{loc:T Game.RunningBadge}" />
                                                </Border>
                                                <Border Style="{StaticResource Pill.Accent}" Padding="7,2" Margin="0,4,0,0"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource Vis.WhenTrue}}">
                                                    <TextBlock Style="{StaticResource Text.Caption}"
                                                               Foreground="{DynamicResource Brush.Accent}"
                                                               Text="{loc:T Game.Pinned}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Game.Processes}" />
                                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                                                       Text="{Binding ProcessesText}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ProcessesText}" />
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                                   Text="{Binding SteamText}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasSteam, Converter={StaticResource Vis.WhenTrue}}" />

                                        <Button Grid.Row="3" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                Padding="12,6" Command="{Binding PinCommand}"
                                                ToolTip="{Binding PinTooltip}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Btn.Soft}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon.Sm}" Text="{Binding PinGlyph}" />
                                                <TextBlock Text="{Binding PinLabel}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,16,0,6"
                                Visibility="{Binding HasGames, Converter={StaticResource Vis.WhenFalse}}">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Game.NoResults}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                   Text="{loc:T Game.NoResultsBody}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================================================== custom + automation / running + how -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- custom games -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="{loc:T Game.CustomTitle}" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                                               Text="{loc:T Game.CustomHelp}" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Soft}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Command="{Binding AddCustomGameCommand}"
                                        ToolTip="{loc:T Game.CustomAddTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphAdd}" />
                                        <TextBlock Text="{loc:T Game.CustomAdd}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CustomGames}" Margin="0,14,0,0"
                                          Visibility="{Binding HasCustomGames, Converter={StaticResource Vis.WhenTrue}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card.Flat}" Margin="0,0,0,8" Padding="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                                        Background="{DynamicResource Brush.SurfaceHover}">
                                                    <TextBlock Style="{StaticResource Icon.Sm}"
                                                               Text="{StaticResource GlyphGame}"
                                                               Foreground="{DynamicResource Brush.Accent}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                                               Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                                               Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding ExecutablePath}" />
                                                </StackPanel>
                                                <ctrl:ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"
                                                                   IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                   ToolTip="{loc:T Game.EnabledTip}" />
                                                <Button Grid.Column="3" Style="{StaticResource Btn.Icon}"
                                                        Command="{Binding RemoveCommand}"
                                                        ToolTip="{loc:T Game.CustomRemoveTip}">
                                                    <TextBlock Style="{StaticResource Icon.Sm}"
                                                               Text="{StaticResource GlyphDelete}"
                                                               Foreground="{DynamicResource Brush.Danger}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,12,0,4"
                                       Text="{loc:T Game.CustomEmpty}"
                                       Visibility="{Binding HasCustomGames, Converter={StaticResource Vis.WhenFalse}}" />
                        </StackPanel>
                    </Border>

                    <!-- automation -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       Text="{loc:T Game.AutomationTitle}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               Text="{loc:T Game.AutoEngage}" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                               Text="{loc:T Game.AutoEngageHelp}" />
                                </StackPanel>
                                <ctrl:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                   IsChecked="{Binding AutoEngageOnGameStart, Mode=TwoWay}"
                                                   ToolTip="{loc:T Game.AutoEngageHelp}" />
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               Text="{loc:T Game.RestoreOnExit}" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                               Text="{loc:T Game.RestoreOnExitHelp}" />
                                </StackPanel>
                                <ctrl:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                   IsChecked="{Binding RestoreOnGameExit, Mode=TwoWay}"
                                                   ToolTip="{loc:T Game.RestoreOnExitHelp}" />
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               Text="{loc:T Game.SuspendOnly}" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                               Text="{loc:T Game.SuspendOnlyHelp}" />
                                </StackPanel>
                                <ctrl:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                   IsChecked="{Binding SuspendAppsOnlyWhileGameRuns, Mode=TwoWay}"
                                                   ToolTip="{loc:T Game.SuspendOnlyHelp}" />
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               Text="{loc:T Game.ConfirmExit}" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                               Text="{loc:T Game.ConfirmExitHelp}" />
                                </StackPanel>
                                <ctrl:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                   IsChecked="{Binding ConfirmExitWhileActive, Mode=TwoWay}"
                                                   ToolTip="{loc:T Game.ConfirmExitHelp}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- currently running -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.CardTitle}"
                                               Text="{loc:T Game.RunningTitle}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                               Text="{Binding RunningSummary}" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Icon}" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" Command="{Binding RefreshRunningCommand}"
                                        ToolTip="{loc:T Game.RunningRefresh}">
                                    <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphRefresh}" />
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RunningGames}" Margin="0,12,0,0"
                                          Visibility="{Binding HasRunningGames, Converter={StaticResource Vis.WhenTrue}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9"
                                                    Background="{DynamicResource Brush.SuccessSoft}">
                                                <TextBlock Text="{Binding Initial}"
                                                           Style="{StaticResource Text.Body}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Success}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.CardTitle}"
                                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                                           Text="{Binding Category}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                                           Text="{Binding Processes}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Processes}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,12,0,4"
                                       Text="{loc:T Game.RunningEmpty}"
                                       Visibility="{Binding HasRunningGames, Converter={StaticResource Vis.WhenFalse}}" />
                        </StackPanel>
                    </Border>

                    <!-- how it works -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Game.HowTitle}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                        Background="{DynamicResource Brush.AccentFaint}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="1"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               Text="{loc:T Game.HowDetect}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                               Text="{loc:T Game.HowDetectBody}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                        Background="{DynamicResource Brush.AccentFaint}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="2"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               Text="{loc:T Game.HowEnforce}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                               Text="{loc:T Game.HowEnforceBody}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                        Background="{DynamicResource Brush.SuccessSoft}" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="3"
                                               Foreground="{DynamicResource Brush.Success}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Style="{StaticResource Text.Body}"
                                               Text="{loc:T Game.HowRestore}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,3,0,0"
                                               Text="{loc:T Game.HowRestoreBody}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</shell:PageBase>
