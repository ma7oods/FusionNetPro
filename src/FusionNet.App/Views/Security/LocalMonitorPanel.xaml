<UserControl x:Class="FusionNet.App.Views.Security.LocalMonitorPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:FusionNet.App.Localization" FlowDirection="{Binding Source={x:Static loc:Loc.Instance}, Path=FlowDirection}" Background="Transparent">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
    <StackPanel Margin="0,0,0,26">
      <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{loc:T Monitor.Ui.Subtitle}" />
      <WrapPanel Margin="0,20,0,8">
        <Button Style="{StaticResource Btn.Primary}" Content="{loc:T Monitor.Ui.Scan}" Command="{Binding ScanCommand}" Margin="0,0,8,8" />
        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Monitor.Ui.Sample}" Command="{Binding SampleTrafficCommand}" Margin="0,0,8,8" />
        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Monitor.Ui.Export}" Command="{Binding ExportCommand}" Margin="0,0,8,8" />
        <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Monitor.Ui.Cancel}" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}" Margin="0,0,0,8" />
      </WrapPanel>
      <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Monitor.Ui.LaunchPrivacy}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding IsSecurity,Converter={StaticResource Visible}}" />
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,12" Foreground="{DynamicResource Brush.Accent}" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}" AutomationProperties.Name="{loc:T Monitor.Ui.Busy}" />
      <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1" Padding="0,16" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Status}" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Summary}" Margin="0,6,0,16" TextWrapping="Wrap" />
          <WrapPanel>
            <StackPanel Width="156" Margin="0,0,12,8"><TextBlock Text="{loc:T Monitor.Ui.ProcessCount}" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding ProcessCount}" Style="{StaticResource Text.MetricSmall}" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Width="156" Margin="0,0,12,8"><TextBlock Text="{loc:T Monitor.Ui.MeasuredCount}" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding MeasuredCount}" Style="{StaticResource Text.MetricSmall}" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Width="156" Margin="0,0,12,8"><TextBlock Text="{loc:T Monitor.Ui.AlertCount}" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding AlertCount}" Style="{StaticResource Text.MetricSmall}" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Width="156" Margin="0,0,0,8"><TextBlock Text="{Binding ContextMetricLabel}" Style="{StaticResource Text.Caption}" /><TextBlock Text="{Binding ContextMetricValue}" Style="{StaticResource Text.MetricSmall}" Margin="0,4,0,0" /></StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16" Visibility="{Binding IsGame, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Monitor.Ui.SessionHeading}" />
          <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:T Monitor.Ui.BlockScope}" Margin="0,6,0,16" />
          <WrapPanel>
            <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Monitor.Ui.Minutes}" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Minutes, UpdateSourceTrigger=PropertyChanged}" Width="72" Margin="0,0,16,8" AutomationProperties.Name="{loc:T Monitor.Ui.MinutesAutomation}" />
            <Button Style="{StaticResource Btn.Primary}" Content="{loc:T Monitor.Ui.Start}" Command="{Binding StartCommand}" Margin="0,0,8,8" />
            <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Monitor.Ui.Stop}" Command="{Binding StopCommand}" Margin="0,0,8,8" />
            <Button Style="{StaticResource Btn.Link}" Content="{loc:T Monitor.Ui.Recommend}" Command="{Binding RecommendCommand}" Margin="0,0,0,8" />
          </WrapPanel>
          <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Session}" Margin="0,8,0,0" />
          <Expander Header="{loc:T Monitor.Ui.ApprovedDetails}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,8,0,0"><TextBlock Style="{StaticResource Text.Muted}" Text="{Binding ApprovedChanges}" Margin="0,8,0,0" /></Expander>
          <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:T Monitor.Ui.UpdatesHint}" Margin="0,16,0,8" TextWrapping="Wrap" />
          <Button Content="{loc:T Monitor.Ui.WindowsUpdateSettings}" Click="OpenWindowsUpdate" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="0,0,0,8" />
        </StackPanel>
      </Border>
      <TabControl Style="{StaticResource Workspace.Tabs}" AutomationProperties.Name="{loc:T Monitor.Ui.SectionsAutomation}">
        <TabItem Header="{loc:T Monitor.Ui.Processes}" Style="{StaticResource Workspace.Tab}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Monitor.Ui.ProcessHeading}" />
              <Expander Header="{loc:T Monitor.Ui.MeasurementLimits}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,8,0,16"><TextBlock Style="{StaticResource Text.Muted}" Text="{loc:T Monitor.Ui.MeasurementDetails}" Margin="0,8,0,0" /></Expander>
              <WrapPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Margin="0,0,0,12">
                <TextBlock Text="{loc:T Monitor.Ui.SearchLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,8" /><TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,14,8" AutomationProperties.Name="{loc:T Monitor.Ui.SearchAutomation}" ToolTip="{loc:T Monitor.Ui.SearchTip}" />
                <CheckBox Style="{StaticResource Input.CheckBox}" Content="{loc:T Monitor.Ui.MeasuredOnly}" IsChecked="{Binding OnlyMeasuredActive,Mode=TwoWay}" Margin="0,8,14,8" />
                <CheckBox Style="{StaticResource Input.CheckBox}" Content="{loc:T Monitor.Ui.ResourceFilter}" IsChecked="{Binding OnlyHighResource,Mode=TwoWay}" Margin="0,8,0,8" />
              </WrapPanel>
              <Border Padding="0,16" Margin="0,0,0,12" Visibility="{Binding HasNoProcesses,Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding EmptyMessage}" Style="{StaticResource Text.Body}" />
              </Border>
              <ListBox ItemsSource="{Binding Processes}" Height="420" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{loc:T Monitor.Ui.ProcessesAutomation}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="4,16">
                      <StackPanel>
                        <DockPanel LastChildFill="True">
                          <CheckBox Style="{StaticResource Input.CheckBox}" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" Visibility="{Binding ShowSelection, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Name}" Margin="0,0,8,0" />
                          <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Name}" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Text="{Binding Purpose}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Resources}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Traffic}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <Expander Header="{loc:T Monitor.Ui.IdentityDetails}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Text}">
                          <StackPanel>
                            <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Path}" TextWrapping="Wrap" FlowDirection="LeftToRight" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Expander>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
        </TabItem>
        <TabItem Header="{loc:T Monitor.Ui.Alerts}" Style="{StaticResource Workspace.Tab}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Monitor.Ui.AlertHeading}" />
              <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Expander Header="{Binding Explanation}" Foreground="{DynamicResource Brush.Text}" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}">
                          <Run Text="{Binding Severity, Mode=OneWay}" />
                          <Run Text="{loc:T Monitor.Ui.Confidence}" />
                          <Run Text="{Binding Confidence, Mode=OneWay}" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,6">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Recommendation}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </TabItem>
        <TabItem Header="{loc:T Monitor.Ui.Coverage}" Style="{StaticResource Workspace.Tab}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Monitor.Ui.CoverageHeading}" />
              <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Expander Header="{Binding Header}" Foreground="{DynamicResource Brush.Text}" Margin="0,10,0,0">
                      <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Name}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Source}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding Detail}" TextWrapping="Wrap" FlowDirection="LeftToRight" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </TabItem>
        <TabItem Header="{loc:T Monitor.Ui.Storage}" Style="{StaticResource Workspace.Tab}" Visibility="{Binding IsSecurity, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Monitor.Ui.StorageHeading}" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Monitor.Ui.StorageDetails}" TextWrapping="Wrap" Margin="0,8" />
              <CheckBox Style="{StaticResource Input.CheckBox}" Content="{loc:T Monitor.Ui.PhotoComparison}" IsChecked="{Binding ComparePhotoContents, Mode=TwoWay}" Margin="0,0,0,12" />
              <WrapPanel>
                <Button Content="{loc:T Monitor.Ui.ScanStorage}" Command="{Binding StorageCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
                <Button Content="{loc:T Monitor.Ui.MonthlyChecklist}" Command="{Binding MonthlyChecklistCommand}" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBox Text="{Binding StorageOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="300" MinHeight="70" Foreground="{DynamicResource Brush.Text}" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" Padding="10" AutomationProperties.Name="{loc:T Monitor.Ui.StorageAutomation}" />
              <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Monitor.Ui.MaintenanceHeading}" Margin="0,24,0,8" />
              <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Monitor.Ui.MaintenanceDetails}" Margin="0,0,0,12" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Content="{loc:T Monitor.Ui.StartupSettings}" Click="OpenStartup" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
                <Button Content="{loc:T Monitor.Ui.InstalledAppsSettings}" Click="OpenInstalledApps" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
                <Button Content="{loc:T Monitor.Ui.FileHistorySettings}" Click="OpenFileHistory" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Monitor.Ui.UsageEvidenceDetails}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </TabItem>
        <TabItem Header="{loc:T Monitor.Ui.Ai}" Style="{StaticResource Workspace.Tab}" Visibility="{Binding IsSecurity, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Monitor.Ui.AiHeading}" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Monitor.Ui.AiDetails}" TextWrapping="Wrap" Margin="0,8" />
              <TextBlock Text="{loc:T Monitor.Ui.Endpoint}" Style="{StaticResource Text.Body}" />
              <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,6,0,12" AutomationProperties.Name="{loc:T Monitor.Ui.EndpointAutomation}" />
              <TextBlock Text="{loc:T Monitor.Ui.Model}" Style="{StaticResource Text.Body}" />
              <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,6,0,12" AutomationProperties.Name="{loc:T Monitor.Ui.ModelAutomation}" />
              <TextBlock Text="{loc:T Monitor.Ui.ApiKey}" Style="{StaticResource Text.Body}" />
              <PasswordBox x:Name="ApiKeyInput" Margin="0,6,0,12" Padding="11,8" FontSize="13" Foreground="{DynamicResource Brush.Text}" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.ControlBorder}" FocusVisualStyle="{StaticResource FocusRing}" CaretBrush="{DynamicResource Brush.Accent}" AutomationProperties.Name="{loc:T Monitor.Ui.ApiKeyAutomation}" />
              <WrapPanel>
                <Button Content="{loc:T Monitor.Ui.SaveProvider}" Click="SaveAiProvider" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
                <Button Content="{loc:T Monitor.Ui.RemoveKey}" Click="RemoveAiKey" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,8" />
                <Button Content="{loc:T Monitor.Ui.Analyze}" Command="{Binding AnalyzeCommand}" Style="{StaticResource Btn.Primary}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBox Text="{Binding AiOutput, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" Padding="10" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="260" MinHeight="80" AutomationProperties.Name="{loc:T Monitor.Ui.AiOutputAutomation}" />
            </StackPanel>
          </Border>
        </TabItem>
        <TabItem Header="{loc:T Monitor.Ui.OfficialTools}" Style="{StaticResource Workspace.Tab}" Visibility="{Binding IsSecurity, Converter={StaticResource Visible}}">
          <Border Style="{StaticResource Card.Flat}">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Monitor.Ui.OptionalTools}" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Monitor.Ui.OfficialToolsDetails}" TextWrapping="Wrap" Margin="0,8" />
              <WrapPanel>
                <Button Content="Autoruns" Click="OpenAutoruns" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" />
                <Button Content="Process Explorer" Click="OpenProcessExplorer" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" />
                <Button Content="LibreHardwareMonitor" Click="OpenHardware" Style="{StaticResource Btn.Ghost}" />
                <Button Content="{loc:T Monitor.Ui.Licenses}" Click="OpenLicenses" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </TabItem>
      </TabControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
