<shell:PageBase x:Class="FusionNet.App.Views.Dns.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:FusionNet.App.Shell"
             xmlns:loc="clr-namespace:FusionNet.App.Localization"
             xmlns:conv="clr-namespace:FusionNet.App.Converters"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="Transparent"
             FlowDirection="{Binding Source={x:Static loc:Loc.Instance}, Path=FlowDirection}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <sys:String x:Key="GlyphStar">&#xE734;</sys:String>

        <Style x:Key="ResultRow" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBest}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentFaint}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <StackPanel Margin="0,0,0,26">

            <!-- ============================================================ header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="{loc:T Page.Dns}" />
                    <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="{loc:T Page.Dns.Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Common.Refresh}"
                            Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Dns.FlushDns}"
                            Command="{Binding FlushDnsCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Btn.Primary}" Content="{loc:T Dns.ApplySelected}"
                            Command="{Binding ApplySelectedCommand}" />
                </StackPanel>
            </Grid>

            <!-- ============================================================ elevation -->
            <Border Style="{StaticResource Card.Flat}" Margin="0,0,0,16"
                    BorderBrush="{DynamicResource Brush.WarningBorder}"
                    Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource Icon.Md}"
                               Foreground="{DynamicResource Brush.Warning}"
                               Text="{StaticResource GlyphAdmin}" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:T Dns.ElevationTitle}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:T Dns.ElevationBody}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}"
                            Content="{loc:T Elevation.RestartElevated}"
                            Command="{Binding RestartElevatedCommand}"
                            VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- ============================================================ current DNS + public IP -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Dns.CurrentTitle}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.Adapter}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" Style="{StaticResource Input.ComboBox}"
                                      MinWidth="230" MaxWidth="300"
                                      ItemsSource="{Binding Adapters}"
                                      SelectedItem="{Binding SelectedAdapter, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Width="120">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.AdapterIPv4}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.ServersLabel}"
                                           Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Label.Status}"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding AdapterIpv4Text}"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding CurrentDnsText}"
                                           Foreground="{DynamicResource Brush.Accent}" Margin="0,10,0,0"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Border Style="{StaticResource Pill.Accent}">
                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                   Foreground="{DynamicResource Brush.Accent}"
                                                   Text="{Binding DnsModeText}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding AdapterDetail}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.ModeHint}"
                                   Margin="0,12,0,0" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Btn.Soft}" Content="{loc:T Dns.ResetAutomatic}"
                                    Command="{Binding ResetAutomaticCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Soft}" Content="{loc:T Dns.ApplyCustom}"
                                    Command="{Binding ApplyCustomCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Dns.PublicIpTitle}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.PublicIpBody}"
                                           Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" VerticalAlignment="Top"
                                    Content="{StaticResource GlyphRefresh}"
                                    Command="{Binding RefreshPublicIpCommand}"
                                    ToolTip="{loc:T Dns.PublicIpTitle}" />
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                                     Visibility="{Binding IsPublicIpBusy, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Style="{StaticResource Text.Mono}" Text="{loc:T Dns.PublicIpLoading}"
                                   Foreground="{DynamicResource Brush.TextDim}" Margin="0,14,0,0"
                                   Visibility="{Binding IsPublicIpBusy, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasPublicIp, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Text.MetricSmall}"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Text="{Binding PublicIpAddress}" TextWrapping="Wrap" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                           Text="{loc:T Dns.IspLabel}" Width="90" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                                           Text="{Binding PublicIsp}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                           Text="{loc:T Dns.CountryLabel}" Width="90" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                                           Text="{Binding PublicCountry}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>

                        <Border Style="{StaticResource Pill.Warning}" Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasPublicIpError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       Text="{Binding PublicIpError}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================================ benchmark -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Dns.BenchmarkTitle}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:T Dns.BenchmarkBody}"
                                       Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Common.Cancel}"
                                    Command="{Binding CancelBenchmarkCommand}"
                                    Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Primary}" Content="{Binding BenchmarkButtonText}"
                                    Command="{Binding BenchmarkCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Success}" Content="{loc:T Dns.ApplyFastest}"
                                    Command="{Binding ApplyFastestCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Text.Eyebrow}" Text="{loc:T Dns.ProvidersTitle}"
                               Margin="0,16,0,8" />

                    <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Panel}" Width="296" Padding="12" Margin="0,0,8,8">
                                    <StackPanel>
                                        <Grid>
                                            <CheckBox Style="{StaticResource Input.CheckBox}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Content="{Binding Name}" />
                                            <Border Style="{StaticResource Pill.Accent}" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           Text="{loc:T Common.Recommended}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding ServersText}"
                                                   Margin="29,5,0,0" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Description}"
                                                   Margin="29,5,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- progress -->
                    <Grid Margin="0,10,0,0" Visibility="{Binding IsBenchmarking, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Height="6" Maximum="100" Value="{Binding BenchmarkProgress, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding BenchmarkText}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="  ·  " />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding BestSummary}"
                                   Foreground="{DynamicResource Brush.Accent}" />
                    </StackPanel>

                    <!-- results -->
                    <Grid Margin="0,16,0,8">
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Dns.ResultsTitle}" />
                        <Border Style="{StaticResource Pill.Success}" HorizontalAlignment="Right"
                                Visibility="{Binding HasBestResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphStar}"
                                           Foreground="{DynamicResource Brush.Success}" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Success}"
                                           Text="{Binding BestSummary}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- table header -->
                    <Border Background="Transparent" Padding="12,0,12,6"
                            Visibility="{Binding Results.Count, Converter={StaticResource CountToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Eyebrow}" Text="#" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Eyebrow}"
                                       Text="{loc:T Dns.ColumnProvider}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Eyebrow}"
                                       Text="{loc:T Dns.ColumnServer}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Text.Eyebrow}"
                                       Text="{loc:T Dns.ColumnLatency}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Text.Eyebrow}"
                                       Text="{loc:T Dns.ColumnStatus}" />
                            <TextBlock Grid.Column="5" Style="{StaticResource Text.Eyebrow}"
                                       Text="{loc:T Dns.ColumnScore}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ResultRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                                   Text="{Binding RankText}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding ProviderName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphStar}"
                                                       Foreground="{DynamicResource Brush.Accent}" Margin="8,0,0,0"
                                                       Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Mono}"
                                                   Text="{Binding Server}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Mono}"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   Text="{Binding LatencyDisplay}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource StatusText}"
                                                   Text="{Binding StatusLabel}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource Text.Mono}"
                                                   Text="{Binding ScoreText}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- empty results -->
                    <Border Style="{StaticResource Card.Flat}" Margin="0,4,0,0"
                            Visibility="{Binding Results.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                        <StackPanel HorizontalAlignment="Center" Margin="0,10">
                            <TextBlock Style="{StaticResource Icon.Lg}" Text="{StaticResource GlyphGlobe}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:T Dns.NoResults}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.PrivacyNote}"
                               Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============================================================ custom DNS + explainer -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{loc:T Dns.CustomTitle}" />
                        <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:T Dns.CustomBody}"
                                   Margin="0,5,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.CustomPrimary}"
                                           Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource Input.TextBox}"
                                         Text="{Binding CustomDns1, UpdateSourceTrigger=PropertyChanged}"
                                         FlowDirection="LeftToRight" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.CustomSecondary}"
                                           Margin="0,0,0,5" />
                                <TextBox Style="{StaticResource Input.TextBox}"
                                         Text="{Binding CustomDns2, UpdateSourceTrigger=PropertyChanged}"
                                         FlowDirection="LeftToRight" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   Text="{Binding CustomDnsError}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasCustomDnsError, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Btn.Soft}" Content="{loc:T Common.Save}"
                                    Command="{Binding SaveCustomDnsCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Btn.Ghost}" Content="{loc:T Dns.ApplyCustom}"
                                    Command="{Binding ApplyCustomCommand}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Caption}" Text="{loc:T Dns.CustomHint}"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon.Md}" Text="{StaticResource GlyphInfo}"
                                       Foreground="{DynamicResource Brush.Info}" Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource Text.SectionTitle}"
                                       Text="{loc:T Dns.ExplainerTitle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" Text="{loc:T Dns.ExplainerBody}"
                                   Margin="0,10,0,0" />

                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphCheck}"
                                           Foreground="{DynamicResource Brush.Success}" Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Dns.ExplainerBullet1}"
                                           MaxWidth="360" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphWarning}"
                                           Foreground="{DynamicResource Brush.Warning}" Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Dns.ExplainerBullet2}"
                                           MaxWidth="360" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon.Sm}" Text="{StaticResource GlyphInfo}"
                                           Foreground="{DynamicResource Brush.Info}" Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Style="{StaticResource Text.Body}" Text="{loc:T Dns.ExplainerBullet3}"
                                           MaxWidth="360" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</shell:PageBase>

